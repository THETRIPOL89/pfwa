# Public env (safe to expose in the browser bundle). Anonymous key only.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Toggle: when "true" the app reads from src/mocks/* instead of Supabase.
# Set to false for production deployments.
VITE_USE_MOCKS=false

# Edge Function base URL. In dev the Vite proxy forwards /api/* to local
# Supabase functions; in prod Vercel rewrites /api/* → /functions/v1/*.
VITE_API_BASE_URL=/api